<script>
function sendOrder() {
  let name = document.getElementById("customerName").value;
  let phone = document.getElementById("customerPhone").value;
  let design = document.getElementById("designType").value;
  let details = document.getElementById("orderDetails").value;

  if (!name || !phone || !design) {
    alert("Please fill in your name, phone number and design service.");
    return;
  }

  let message = "Hello FS² Designs! I want to place an order."
    + "\nName: " + name
    + "\nPhone: " + phone
    + "\nDesign: " + design
    + "\nDetails: " + details;

  let url = "https://wa.me/2348125439232?text="
    + encodeURIComponent(message);

  window.open(url, "_blank");
}
</script>

